# ============================================================
# Claims Copilot — Environment Configuration Template
# ============================================================

# ------------------------------------------------------------
# 1. Supabase Configuration (Client-Safe / Public)
# ------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------
# 2. Supabase Service Role (Server-Only / Private)
# ------------------------------------------------------------
# Required for server-side document storage and processing.
# NEVER expose this key to client-side code or commit to git.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------
# 3. AI Inference Providers (Server-Only / Private)
# ------------------------------------------------------------
# Hugging Face Access Token: Used for 384-dim text embedding generation (BAAI/bge-small-en-v1.5)
# Obtain from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your-huggingface-api-key

# Groq API Key: Used for ultra-fast grounded LLM response generation (openai/gpt-oss-120b)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
